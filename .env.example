# --- Application ---
APP_NAME=RuralCare AI
DEBUG=false

# --- Database ---
# Default (zero-setup local/hackathon demo): SQLite
DATABASE_URL=sqlite:///./ruralcare.db
# Production-style (see docker-compose.yml):
# DATABASE_URL=postgresql://ruralcare:ruralcare@localhost:5432/ruralcare

# --- Security ---
SECRET_KEY=change-me-in-production

# --- CORS (comma-separated list is parsed by pydantic-settings as JSON array or repeat var) ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- GenAI (optional; falls back to deterministic templates when unset) ---
GENAI_PROVIDER=template
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# --- Data mode ---
DEMO_MODE=true
